{
  "name": "@simple-monitor/shared",
  "version": "1.0.0",
  "description": "Shared constants and utilities for Simple Monitor SDK",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-monitor/types": "workspace:*"
  },
  "keywords": [
    "monitor",
    "shared"
  ],
