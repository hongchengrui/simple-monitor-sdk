{
  "name": "@simple-monitor/browser",
  "version": "0.0.1",
  "description": "Browser platform adapter for Simple Monitor SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-monitor/types": "workspace:*",
    "@simple-monitor/shared": "workspace:*",
    "@simple-monitor/utils": "workspace:*",
    "@simple-monitor/core": "workspace:*"
  },
  "keywords": [
    "monitor",
    "browser"
  ],
  "author": "",
  "license": "MIT"
}
